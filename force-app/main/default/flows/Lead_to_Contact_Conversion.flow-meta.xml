    <description>2026-09-28: 선택 리드를 컬렉션으로 한 번 전환하고 실패 시 전체 변경을 롤백합니다. Subflow는 결과 출력으로 오류를 전달하며, 조회 실패는 공통 Flow 로거와 안내 화면으로 처리합니다.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmPrimaryHolderId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_the_Lead.Primaryholder__c}), {!Get_the_Lead.Id}, {!Get_the_Lead.Primaryholder__c})</expression>
    </formulas>
    <interviewLabel>Convert to Account &amp; Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Convert to Account &amp; Contact</label>
    <loops>
        <name>Each_Selected_Lead</name>
        <label>Each Selected Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Household_Selector.selectedLeads</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_Lead_Unconverted</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Has_Selected_Leads</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_the_Lead</name>
        <label>Get the Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Source_Lead</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Get_the_Lead_Failure</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>LastName</queriedFields>
        <queriedFields>Contact__c</queriedFields>
        <queriedFields>Primaryholder__c</queriedFields>
        <queriedFields>IsConverted</queriedFields>
        <queriedFields>ConvertedContactId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Household_Others</name>
        <label>Get Household Others</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Household_Others</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Get_Household_Others_Failure</targetReference>
        </faultConnector>
        <filterLogic>(1 OR 2) AND 3</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frmPrimaryHolderId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primaryholder__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frmPrimaryHolderId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lead</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Converted_Lead</name>
        <label>Get Converted Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Converted_Contact</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Get_Converted_Lead_Failure</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>LastName</queriedFields>
        <queriedFields>Contact__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Household_All</name>
        <label>Get Household All</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Household_Records</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Get_Household_All_Failure</targetReference>
        </faultConnector>
        <filterLogic>1 OR 2</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frmPrimaryHolderId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Primaryholder__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frmPrimaryHolderId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lead</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>LastName</queriedFields>
        <queriedFields>Contact__c</queriedFields>
        <queriedFields>IsConverted</queriedFields>
        <queriedFields>Familial_Relationship__c</queriedFields>
        <queriedFields>Is_Primaryholder__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordRollbacks>
        <name>Roll_Back_Conversion</name>
        <label>Roll Back Conversion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Duplicate_Error</targetReference>
        </connector>
    </recordRollbacks>
    <screens>
        <name>Conversion_Complete</name>
        <label>Conversion Complete</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Conversion_Completion_Message</name>
            <fieldText>&lt;p style="font-size:20px; line-height:1.5;"&gt;&lt;strong style="color:#2e844a;"&gt;&amp;#10003; 전환이 완료되었습니다&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p style="font-size:16px; line-height:1.6;"&gt;새 컨택트가 만들어졌습니다 &amp;mdash; &lt;a href="/{!Get_Converted_Lead.Contact__c}" target="_top"&gt;&lt;strong&gt;{!Get_Converted_Lead.FirstName} {!Get_Converted_Lead.LastName}&lt;/strong&gt;&lt;/a&gt;&lt;/p&gt;&lt;p style="color:#5c5c5c; font-size:13px; line-height:1.6;"&gt;이름을 클릭하면 컨택트 레코드로 이동합니다.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p style="font-size:13px; color:#3e3e3c; line-height:1.7;"&gt;상담 노트와 첨부 파일, 메디케어 정보, 가족 관계가 함께 이관되었습니다.&lt;br&gt;이 리드는 삭제되지 않고 그대로 남아 있으며, 컨택트와 연결되어 있습니다.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>완료</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Duplicate_Contact_Message</name>
        <label>Duplicate Detected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Duplicates_Warning_Message</name>
            <fieldText>&lt;div style="border-left:4px solid #ba0517; padding:4px 0 4px 14px;"&gt;&lt;p style="font-size:19px; line-height:1.5; margin:0;"&gt;&lt;strong style="color:#ba0517;"&gt;&amp;#9888; 이미 등록된 컨택트가 있습니다&lt;/strong&gt;&lt;/p&gt;&lt;/div&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p style="font-size:15px; line-height:1.6;"&gt;같은 사람으로 보이는 컨택트가 이미 있어서 새로 만들지 않았습니다. &lt;strong&gt;이 리드는 그대로 남아 있습니다.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p style="font-size:14px; margin-bottom:2px;"&gt;&lt;strong&gt;다음 중 하나를 해 주세요&lt;/strong&gt;&lt;/p&gt;&lt;ul style="font-size:14px; line-height:1.7; margin-top:2px;"&gt;&lt;li&gt;기존 컨택트를 찾아 이 리드의 정보를 옮겨 적기&lt;/li&gt;&lt;li&gt;동명이인이라면 이름이나 생년월일을 구분되게 고친 뒤 다시 전환하기&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;div style="border-left:3px solid #c9c7c5; background:#f3f3f3; padding:10px 14px; margin-top:4px;"&gt;&lt;p style="color:#514f4d; font-size:12px; line-height:1.6; margin:0;"&gt;&lt;strong&gt;오류 상세&lt;/strong&gt;&lt;br&gt;대상 리드: {!Get_the_Lead.FirstName} {!Get_the_Lead.LastName} ({!recordId})&lt;br&gt;{!errorMessage}&lt;br&gt;단계: {!errorStep}&lt;/p&gt;&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
