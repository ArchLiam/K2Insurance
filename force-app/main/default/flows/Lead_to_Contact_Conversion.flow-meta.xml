            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_the_Lead.Contact__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Already_Converted</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
