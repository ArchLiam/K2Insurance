            <targetReference>Roll_Back_Conversion</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Was_Single_Conversion_Successful_Yes</name>
            <conditionLogic>and</conditionLogic>
